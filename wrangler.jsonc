{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sounds-of-medicine",
  // Cron wrapper. `npx opennextjs-cloudflare build` must run first; deploy then bundles this file.
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference. The service must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sounds-of-medicine"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Fires even when push KV is absent. The handler does nothing until VAPID and YAOSHENG_PUSH are set.
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
  // Optional bindings. Leave every block below commented out so `npx wrangler deploy` does not
  // require a namespace that has not been created. The app keeps working without them.
  //
  // Family share short links (AES-GCM key stays in the URL fragment either way):
  // "vars": { "YAOSHENG_SYNC_ENABLED": "1" },
  // "kv_namespaces": [
  //   { "binding": "YAOSHENG_SYNC", "id": "replace-with-namespace-id" }
  // ],
  //
  // Paid-route counters. Per-IP and per-device limits also fall back to memory in each isolate.
  // "vars": { "YAOSHENG_LIMITS_ENABLED": "1" },
  // "kv_namespaces": [
  //   { "binding": "YAOSHENG_LIMITS", "id": "replace-with-namespace-id" }
  // ],
  //
  // Cloudflare Rate Limiting binding. namespace_id is a number you choose; no separate resource.
  // Uncomment to enforce a global limit in addition to the memory/KV windows.
  // "ratelimits": [
  //   { "name": "YAOSHENG_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  // ],
  //
  // Care-circle sync. Ciphertext only. Create the database with `npx wrangler d1 create yaosheng`,
  // put the id below, uncomment, then `npx wrangler d1 migrations apply yaosheng --remote`.
  // "vars": { "YAOSHENG_DB_ENABLED": "1" },
  // "d1_databases": [
  //   {
  //     "binding": "YAOSHENG_DB",
  //     "database_name": "yaosheng",
  //     "database_id": "replace-with-database-id",
  //     "migrations_dir": "migrations"
  //   }
  // ],
  //
  // Web Push subscriptions. Values are a device id, clock times, language, and the push endpoint.
  // Drug names and patient names are not stored. Also set secrets VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT.
  // "vars": { "YAOSHENG_PUSH_ENABLED": "1" },
  // "kv_namespaces": [
  //   { "binding": "YAOSHENG_PUSH", "id": "replace-with-namespace-id" }
  // ],
  //
  // LINE Official Account. These are secrets, not bindings, so a missing value does not fail deploy:
  // LINE_MESSAGING_CHANNEL_SECRET, LINE_MESSAGING_ACCESS_TOKEN, LINE_LIFF_ID, LINE_DATA_KEY.
  // The webhook is /api/line/webhook. LINE Notify is discontinued and is not used.
  //
  // Turnstile is off until both secrets exist: TURNSTILE_SECRET_KEY and TURNSTILE_SITE_KEY.
  // Sentry is off until SENTRY_DSN is set. Analytics is off until CF_ANALYTICS_TOKEN is set.
  // None of those are bindings, so a missing secret does not fail deploy.
}
