{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sounds-of-medicine",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference. The service must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sounds-of-medicine"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
