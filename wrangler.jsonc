{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sounds-of-medicine",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference. The service must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sounds-of-medicine"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
  // Optional family sync. Leave this commented out so deploy does not require a KV namespace.
  // The app already shares an encrypted link with the key in the URL fragment.
  // To turn on short links: create a KV namespace, uncomment both blocks, and redeploy.
  // "vars": {
  //   "YAOSHENG_SYNC_ENABLED": "1"
  // },
  // "kv_namespaces": [
  //   { "binding": "YAOSHENG_SYNC", "id": "replace-with-namespace-id" }
  // ]
}
